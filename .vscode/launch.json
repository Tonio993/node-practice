{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import", "tsx/esm",
        "--inspect"
      ],
      "args": ["src/server.ts"],
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/src/**/*.ts"],
      "skipFiles": ["<node_internals>/**", "node_modules/**"]
    }
  ]
}